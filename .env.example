# Your Orbio key (claim it via the Orbio MCP: orbio_claim_key). Never commit it.
ORBIO_API_KEY=sk-orbio-...
ORBIO_BASE_URL=https://api.orbio.so/api/v1

# Stop the benchmark once total spend passes this many dollars.
BENCH_BUDGET_USD=8

# Live races on the public site need this token (leave empty to disable live mode).
RACE_TOKEN=
LIVE_BUDGET_USD=1

# Public URL of the deployed site (used for share cards and the sitemap).
NEXT_PUBLIC_SITE_URL=https://your-site.example
